# Urahara Studio - Environment Configuration Template
# Renomeie este arquivo para .env e configure suas chaves de API

# Google Gemini (Principal e 100% Gratuito)
# Obtenha sua chave gratuita em: https://aistudio.google.com/apikey
# Para rotação automática, adicione múltiplas chaves separadas por vírgula
GEMINI_API_KEY=

# Modelo Gemini Padrão (gemini-3.8-flash, gemini-3.7-flash, gemini-2.5-flash, gemini-flash-lite-latest)
GEMINI_MODEL=gemini-3.8-flash

# Provedor de Fallback Gratuito Groq (14.400 req/dia grátis)
# Obtenha sua chave em: https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter (Opcional) - https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Felo API (Opcional) - https://openapi.felo.ai
FELO_API_KEY=

# APIs de Metadados Oficiais (Animes e Doramas)
ANIME_API_ENABLED=true
SERIES_API_ENABLED=true

# Verificação Automática de Atualizações
CHECK_UPDATES_ON_STARTUP=true
